(function () {
  // ── Prevent double-injection ──────────────────────────────
  if (window.__voiceCommander) {
    console.warn("🎙️ Voice Commander already running. Say 'stop listening' to stop it first.");
    return;
  }

  // ── Guard: Web Speech API ─────────────────────────────────
  if (!("webkitSpeechRecognition" in window) && !("SpeechRecognition" in window)) {
    alert("❌ Your browser doesn't support the Web Speech API.\nUse Google Chrome for voice commands.");
    return;
  }

  // ── Create HUD overlay ───────────────────────────────────
  const hud = document.createElement("div");
  hud.id = "__voice_hud";
  Object.assign(hud.style, {
    position: "fixed",
    bottom: "24px",
    right: "24px",
    zIndex: "999999",
    background: "linear-gradient(135deg, #1a1a2e 0%, #16213e 100%)",
    color: "#e0e0ff",
    fontFamily: "'Segoe UI', sans-serif",
    fontSize: "13px",
    padding: "14px 18px",
    borderRadius: "16px",
    boxShadow: "0 8px 32px rgba(0,0,255,0.3), 0 0 0 1px rgba(255,255,255,0.08)",
    minWidth: "260px",
    maxWidth: "340px",
    transition: "opacity 0.3s ease",
    userSelect: "none",
    backdropFilter: "blur(12px)",
  });

  hud.innerHTML = `
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;">
      <div id="__voice_dot" style="width:10px;height:10px;border-radius:50%;background:#4ade80;box-shadow:0 0 8px #4ade80;flex-shrink:0;"></div>
      <span style="font-weight:700;font-size:14px;letter-spacing:0.5px;">Voice Commander</span>
      <button id="__voice_close" style="margin-left:auto;background:none;border:none;color:#aaa;cursor:pointer;font-size:16px;line-height:1;padding:0;">✕</button>
    </div>
    <div id="__voice_status" style="color:#94a3b8;font-size:12px;margin-bottom:6px;">Initialising…</div>
    <div id="__voice_transcript" style="background:rgba(255,255,255,0.05);border-radius:8px;padding:8px 10px;min-height:36px;color:#e2e8f0;font-size:13px;line-height:1.5;word-break:break-word;">—</div>
    <div style="margin-top:8px;color:#475569;font-size:11px;">Say <em>"stop listening"</em> to quit</div>
  `;
  document.body.appendChild(hud);

  const dot        = document.getElementById("__voice_dot");
  const statusEl   = document.getElementById("__voice_status");
  const transcriptEl = document.getElementById("__voice_transcript");

  document.getElementById("__voice_close").addEventListener("click", stopAll);

  function setStatus(text, color = "#94a3b8") {
    statusEl.textContent = text;
    statusEl.style.color = color;
  }

  function setTranscript(text) {
    transcriptEl.textContent = text || "—";
  }

  function pulse(ok) {
    dot.style.background    = ok ? "#4ade80" : "#f87171";
    dot.style.boxShadow     = ok ? "0 0 8px #4ade80" : "0 0 8px #f87171";
    dot.style.animation     = "none";
    setTimeout(() => {
      dot.style.background  = "#4ade80";
      dot.style.boxShadow   = "0 0 8px #4ade80";
    }, 600);
  }

  // ── Helpers ───────────────────────────────────────────────
  function getSearchBox() {
    return (
      document.querySelector("textarea[name='q']") ||
      document.querySelector("input[name='q']") ||
      document.querySelector("input[title='Search']") ||
      document.querySelector("[role='combobox']")
    );
  }

  function smoothScroll(amount) {
    window.scrollBy({ top: amount, behavior: "smooth" });
  }

  function toast(msg) {
    setTranscript("✅ " + msg);
    console.log("🎙️ Voice Commander:", msg);
  }

  // ── Command dispatcher ────────────────────────────────────
  function handleCommand(raw) {
    const cmd = raw.toLowerCase().trim();
    setTranscript("🎤 " + raw);

    // STOP
    if (cmd.includes("stop listening") || cmd.includes("stop voice")) {
      toast("Stopped. Goodbye!");
      setTimeout(stopAll, 1000);
      return;
    }

    // SCROLL
    if (cmd.includes("scroll down")) {
      const amt = cmd.includes("lot") ? 800 : 400;
      smoothScroll(amt);
      toast("Scrolled down");
      return;
    }
    if (cmd.includes("scroll up")) {
      const amt = cmd.includes("lot") ? 800 : 400;
      smoothScroll(-amt);
      toast("Scrolled up");
      return;
    }
    if (cmd.includes("scroll to top") || cmd.includes("go to top")) {
      window.scrollTo({ top: 0, behavior: "smooth" });
      toast("Jumped to top");
      return;
    }
    if (cmd.includes("scroll to bottom") || cmd.includes("go to bottom")) {
      window.scrollTo({ top: document.body.scrollHeight, behavior: "smooth" });
      toast("Jumped to bottom");
      return;
    }

    // NAVIGATION
    if (cmd === "go back" || cmd === "back") {
      history.back();
      toast("Going back");
      return;
    }
    if (cmd === "go forward" || cmd === "forward") {
      history.forward();
      toast("Going forward");
      return;
    }
    if (cmd === "refresh" || cmd === "reload") {
      toast("Reloading…");
      setTimeout(() => location.reload(), 800);
      return;
    }

    // SEARCH BOX FOCUS
    if (cmd.includes("open search") || cmd.includes("focus search") || cmd.includes("click search")) {
      const box = getSearchBox();
      if (box) {
        box.focus();
        box.select && box.select();
        toast("Search bar focused");
      } else {
        setTranscript("⚠️ Search box not found");
      }
      return;
    }

    // SEARCH <query>
    const searchMatch = cmd.match(/^(?:search|search for|google)\s+(.+)$/);
    if (searchMatch) {
      const query = searchMatch[1].trim();
      const box = getSearchBox();
      if (box) {
        box.focus();
        // Clear + set natively so React/Angular listeners fire
        const nativeInput = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, "value") ||
                            Object.getOwnPropertyDescriptor(window.HTMLTextAreaElement.prototype, "value");
        if (nativeInput && nativeInput.set) {
          nativeInput.set.call(box, query);
        } else {
          box.value = query;
        }
        box.dispatchEvent(new Event("input", { bubbles: true }));
        box.dispatchEvent(new Event("change", { bubbles: true }));
        toast(`Searching for: "${query}"`);
        setTimeout(() => {
          box.dispatchEvent(new KeyboardEvent("keydown", { key: "Enter", keyCode: 13, bubbles: true }));
          box.closest("form") && box.closest("form").submit();
        }, 600);
      } else {
        // fallback: redirect
        toast(`Navigating to search: "${query}"`);
        setTimeout(() => {
          location.href = "https://www.google.com/search?q=" + encodeURIComponent(query);
        }, 500);
      }
      return;
    }

    // TYPE <text> (just type into search box without submitting)
    const typeMatch = cmd.match(/^type\s+(.+)$/);
    if (typeMatch) {
      const text = typeMatch[1].trim();
      const box = getSearchBox();
      if (box) {
        box.focus();
        box.value = text;
        box.dispatchEvent(new Event("input", { bubbles: true }));
        toast(`Typed: "${text}"`);
      } else {
        setTranscript("⚠️ No input box found");
      }
      return;
    }

    // CLEAR
    if (cmd === "clear" || cmd === "clear search") {
      const box = getSearchBox();
      if (box) { box.value = ""; box.focus(); toast("Cleared search box"); }
      return;
    }

    // CLICK FIRST RESULT
    if (cmd.includes("click first result") || cmd.includes("open first result")) {
      const first = document.querySelector("#search a[href], #rso a[href]");
      if (first) {
        toast("Opening first result…");
        setTimeout(() => first.click(), 400);
      } else {
        setTranscript("⚠️ No results found on page");
      }
      return;
    }

    // UNKNOWN
    pulse(false);
    setTranscript("❓ Not recognised: "" + raw + """);
    console.warn("🎙️ Unknown command:", raw);
  }

  // ── Speech Recognition setup ──────────────────────────────
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  const recognition = new SR();
  recognition.continuous    = true;
  recognition.interimResults = true;
  recognition.lang          = "en-US";
  recognition.maxAlternatives = 1;

  let finalising = false;

  recognition.onstart = () => {
    setStatus("🎙️ Listening…", "#4ade80");
    dot.style.animation = "none";
  };

  recognition.onend = () => {
    if (window.__voiceCommander) {
      // auto-restart so it keeps listening
      setTimeout(() => {
        try { recognition.start(); } catch (e) {}
      }, 300);
    }
  };

  recognition.onerror = (e) => {
    if (e.error === "no-speech") return;
    if (e.error === "not-allowed") {
      setStatus("❌ Mic permission denied", "#f87171");
      setTranscript("Please allow microphone access and refresh.");
      stopAll();
      return;
    }
    console.warn("Speech error:", e.error);
    setStatus("⚠️ Error: " + e.error, "#fbbf24");
  };

  recognition.onresult = (e) => {
    let interim = "";
    let final   = "";
    for (let i = e.resultIndex; i < e.results.length; i++) {
      const t = e.results[i][0].transcript;
      if (e.results[i].isFinal) final += t;
      else interim += t;
    }
    if (interim) {
      setTranscript("💬 " + interim + "…");
    }
    if (final.trim()) {
      pulse(true);
      handleCommand(final.trim());
    }
  };

  recognition.start();

  // ── Stop / cleanup ────────────────────────────────────────
  function stopAll() {
    window.__voiceCommander = false;
    try { recognition.abort(); } catch (_) {}
    dot.style.background = "#f87171";
    dot.style.boxShadow  = "0 0 8px #f87171";
    setStatus("🔴 Stopped", "#f87171");
    setTimeout(() => {
      hud.style.opacity = "0";
      setTimeout(() => hud.remove(), 400);
    }, 1500);
    console.log("🎙️ Voice Commander stopped.");
  }

  window.__voiceCommander = true;

  console.log(`
%c🎙️ Voice Commander ACTIVE
%cAvailable commands:
  "scroll down / up"
  "scroll to top / bottom"
  "open search"
  "search <your query>"
  "type <text>"
  "click first result"
  "go back / forward"
  "refresh"
  "stop listening"
`, "color:#4ade80;font-weight:bold;font-size:16px", "color:#94a3b8;font-size:13px");

})();
